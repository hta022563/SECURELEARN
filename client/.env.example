# =============================================================================
# SECURELEARN - FRONT-END ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# =============================================================================
VITE_API_URL=http://localhost:8080/api/v1
VITE_LAMBDA_API_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com/api/v1

# AWS Cognito Configuration
VITE_AWS_REGION=ap-southeast-1
VITE_AWS_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_AWS_CLIENT_ID=your-cognito-app-client-id
VITE_AWS_REDIRECT_URI=http://localhost:3000
