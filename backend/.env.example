# =============================================================================
# SecureLearn Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values
# NEVER commit the .env file to version control!

# PostgreSQL Database (REQUIRED)
POSTGRES_DB=SecureLearn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Hibernate Configuration
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# AWS Cognito (REQUIRED)
COGNITO_CLIENT_SECRET=your-cognito-client-secret-here

# AWS Region
AWS_REGION=ap-southeast-1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

COGNITO_POOL_ID=your_User_pool_ID

AWS_ACCESS_KEY_ID=your iam user with cognitoAdminp permission here access key here
AWS_SECRET_ACCESS_KEY=your iam user with cognitoAdminp permission here secret access key here