# AWS Cognito Configuration
COGNITO_CLIENT_SECRET=your-cognito-client-secret-here

# CORS Configuration
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# Add your frontend URLs here (development and production)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Database Configuration (PostgreSQL - optional, defaults in application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/SecureLearn
# DB_USERNAME=postgres
# DB_PASSWORD=12345

# AWS DynamoDB Configuration
# For local development with DynamoDB Local, use:
# AWS_DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_DYNAMODB_REGION=ap-southeast-1

# For production (AWS), leave endpoint empty and configure:
# AWS_DYNAMODB_REGION=ap-southeast-1
# AWS_DYNAMODB_ACCESS_KEY=your-access-key (or use IAM roles)
# AWS_DYNAMODB_SECRET_KEY=your-secret-key (or use IAM roles)
